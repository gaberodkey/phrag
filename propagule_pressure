#Two-sample t tests and graphs in RStudio for long- (≥9 yrs) and short-term (≤3 yrs) herbicide treatment comparing: 
# overall propagule pressure of P. australis (seeds/m^2 of marshland),
# seed production per area of P. austrlais  (seeds/m^2 of P. australis),
# % phragmites area,
# inflorescence density (stems/m^2),
# inflorescence size (g and seeds/inflorescence),
# seeds/spikelet,
# and germination rate.
### all error bars represent standard error of the mean #####

rm(list = ls())

library(readr)
library(dplyr)
library(ggplot2)

#Includes overall propagule pressure estimates and all measurements used in calculation for sampled land parcels
prpgl_prsr <- read_csv("~/Library/prpgl_prsr.csv")

#Includes percent P. australis cover and additional details such as ownership and treatment for all land parcels in the marsh
all_club_cover <- read_csv("~/Library/all_club_cover.csv")

#Keeping only the useful columns
phrag <- prpgl_prsr %>%
  select(c(unit, site, patch_num, flr_strp, trmt, seeds_mean, spk_flr, seed_flr, mean_flr_dns_m2, prop_prsr_m2, germ_rate, yrs_spraying, phrag_marsh, prop_prsr_marsh))

#Classifying all of the clubs with P. australis by years of treatment
all_club_cover <- all_club_cover %>%
  mutate(trmt = ifelse(trmt_yrs >= 9, "9-21 years (Long-term)", 
                       ifelse(trmt_yrs >= 4 & trmt_yrs <= 8, "4-8 years",
                       ifelse(trmt_yrs <= 3, "0-3 years (Short-term)", NA))))

##### OVERALL PROPAGULE PRESSURE #####
##### (seeds/m^2 of marsh) #####

#2-sample t-test:
t.test(data = phrag, prop_prsr_marsh ~ trmt)

#Summary table of overall propagule pressure in Long- and Short-term treatments:
ppxtrmt_summ <- summarise_at(group_by(phrag, trmt), vars(prop_prsr_marsh),
                             funs(count = sum(!is.na(prop_prsr_marsh)), meanpp = mean(prop_prsr_marsh,na.rm=T),
                                  sdpp = sd(prop_prsr_marsh, na.rm=T), sepp = sdpp/sqrt(count)))

#Bar plot visual of overall propagule pressure in Long- and Short-term treatments:
ggplot(ppxtrmt_summ, aes(fill = trmt, x = trmt, y = meanpp)) +
  geom_col(color = "black", show.legend = FALSE, width = 0.5) +
  geom_errorbar(aes(x = trmt, ymin = meanpp - sepp, ymax = meanpp + sepp), width = 0.1) +
  theme_classic() +
  ylab(expression(paste("Mean propagule pressure (seeds per ", m^2, " of marsh)"))) +
  xlab("Historical Herbicide") +
  scale_fill_manual(values = c("grey", "white")) +
  theme(axis.text = element_text(size = 15)) +
  theme(axis.title = element_text(size = 15)) +
  scale_y_continuous(labels = scales::comma)

#Summary table of propagule pressure in each land parcel sampled:
ppxsite_summ <- summarise_at(group_by(phrag, unit, yrs_spraying, trmt), vars(prop_prsr_marsh),
                       funs(count = sum(!is.na(logpp)), meanpp = mean(prop_prsr_marsh,na.rm = T), sdpp = sd(prop_prsr_marsh, na.rm=T), sepp = sdpp/sqrt(count)))

#Bar plot of overall propagule pressure in each land parcel sampled:
ggplot(ppxsite_summ, aes(fill = trmt, (x = reorder(unit, -meanpp)), y = meanpp)) +
  geom_col(color = "black") +
  geom_errorbar(aes(x = unit, ymin = meanpp - sepp, ymax = meanpp + sepp), width = 0.2) +
  theme_classic() +
  scale_fill_manual(values = c("grey", "white")) +
  ylab(expression(paste("Mean propagule pressure (seeds per ", m^2, " of marsh)"))) +
  xlab("Land Parcel") +
  labs(fill = "Historical Herbicide") +
  scale_y_continuous(labels = scales::comma) +
  theme(axis.text = element_text(size = 12)) +
  theme(legend.title = element_text(face = "bold", size = 15)) +
  theme(legend.text = element_text(face = "bold", size = 15)) 


##### SEED PRODUCTION PER AREA OF P.AUSTRALIS #####
