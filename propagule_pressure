                             funs(count = sum(!is.na(prop_prsr_m2)), meansp = mean(prop_prsr_m2,na.rm=T),
                                  sdsp = sd(prop_prsr_m2, na.rm=T), sesp = sdsp/sqrt(count)))

#Bar plot of seed production in each site sampled:
ggplot(spxtrmt_summ, aes(fill = trmt, x = trmt, y = meansp)) +
  geom_col(color = "black", show.legend = FALSE, width = 0.5) +
  geom_errorbar(aes(x = trmt, ymin = meansp - sesp, ymax = meansp + sesp), width = 0.1) +
