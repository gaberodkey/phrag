  theme_classic() +
  scale_fill_manual(values = c("grey", "white")) +
  ylab(expression(paste("Mean # of seeds produced per ", m^2, " of", italic (" P. australis")))) +
  xlab("Land Parcel") +
  labs(fill = "Historical Herbicide") +
  theme(axis.text = element_text(size = 12)) +
  theme(axis.title = element_text(face = "bold", size = 12)) +
  theme(legend.title = element_text(face = "bold", size = 15)) +
  theme(legend.text = element_text(face = "bold", size = 15)) +
  scale_y_continuous(labels = scales::comma)


##### PERCENT P.AUSTRALIS AREA COVER #####
##########

#Aggregate to one site per row
phrag_unique <- phrag %>%
  group_by(site, trmt) %>%
  summarise(phrag_marsh = mean(phrag_marsh, na.rm = TRUE)) %>%
  ungroup()

#2-sample t-test (SAMPLED LAND PARCELS):
t.test(data = phrag_unique, phrag_marsh ~ trmt)

#2-sample t-test (ALL LAND PARCELS)
t.test(data = all_club_cover, cover ~ trmt)

#Summary table of P. australis cover in Long- and Short-term treatments (SAMPLED LAND PARCELS):
phragarea_summ1 <- summarise_at(group_by(phrag, trmt), vars(phrag_marsh),
                            funs(count = sum(!is.na(phrag_marsh)), meanphragmarsh = mean(phrag_marsh,na.rm=T),
                                 sdphragmarsh = sd(phrag_marsh, na.rm=T), sephragmarsh = sdphragmarsh/sqrt(count)))

#Summary table of P. australis cover in Long-, Short-, and Medium-term treatments (ALL LAND PARCELS):
phragarea_summ2 <- summarise_at(group_by(all_club_cover, trmt), vars(cover),
                                funs(count = sum(!is.na(cover)), meancover = mean(cover,na.rm=T),
                                     sdcover = sd(cover, na.rm=T), secover = sdcover/sqrt(count)))

#Bar plot of P. australis area in Long- and Short-term treatments(SAMPLED LAND PARCELS):
ggplot(phragarea_summ1, aes(fill = trmt, x = trmt, y = meanphragmarsh)) +
  geom_col(color = "black", show.legend = F, width = .5) +
  geom_errorbar(aes(x = trmt, ymin = meanphragmarsh - sephragmarsh, ymax = meanphragmarsh + sephragmarsh), width = 0.1) +
  theme_classic() +
  scale_fill_manual(values = c("grey", "white")) +
  ylab(expression(paste("Mean", italic(" P. australis"), " cover per area of marsh ", (m^2)))) +
  xlab("Herbicide Treatment") +
  theme(axis.text = element_text(size = 15)) +
  theme(axis.title = element_text(size = 15))

#Bar plot of P. australis area in Long- and Short-term treatments (ALL LAND PARCELS):
ggplot(phragarea_summ2, aes(fill = trmt, (x = reorder(trmt, -meancover)), y = meancover)) +
  geom_col(color = "black", show.legend = F, width = .5) +
  geom_errorbar(aes(x = trmt, ymin = meancover - secover, ymax = meancover + secover), width = 0.1) +
  theme_classic() +
  scale_fill_manual(values = c("white", "white", "white")) +
  ylab(expression(paste("Mean", italic(" P. australis"), " cover per area of marsh ", (m^2)))) +
  xlab("Years of Herbicide Treatment") +
  theme(axis.text = element_text(size = 15)) +
  theme(axis.title = element_text(size = 15))


