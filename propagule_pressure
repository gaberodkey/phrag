                          funs(count = sum(!is.na(logppp)), meanppp = mean(prop_prsr_m2,na.rm = T), sdppp = sd(prop_prsr_m2, na.rm=T), seppp = (sdppp/sqrt(count))))

#Bar plot of seed production in each site sampled:
